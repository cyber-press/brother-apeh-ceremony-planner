# Change this before exposing the API to the Internet.
PLANNER_ACCESS_KEY=replace-with-a-long-random-family-key

# Local development:
PLANNER_DB_PATH=./data/planner.db

# Origins are comma-separated. GitHub Pages uses the origin only, not the repository path.
PLANNER_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://cyber-press.github.io
